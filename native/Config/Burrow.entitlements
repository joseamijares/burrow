<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No app sandbox: Burrow runs Mole (`mo`), git and launchctl as child processes and
	     reads other apps' caches, which a sandboxed app can't (docs/native-swiftui-scope.md §3).
	     The hardened runtime stays on; nothing here relaxes it. -->
</dict>
</plist>
